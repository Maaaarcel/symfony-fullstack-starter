{
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "ext-opentelemetry": "*",
        "ext-grpc": "*",
        "doctrine/doctrine-bundle": "^3.2.2",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.6.3",
        "nyholm/psr7": "^1.8",
        "open-telemetry/exporter-otlp": "^1.4",
        "open-telemetry/opentelemetry-auto-doctrine": "^0.5",
        "open-telemetry/opentelemetry-auto-pdo": "^0.5",
        "open-telemetry/opentelemetry-auto-psr3": "^0.3.0",
        "open-telemetry/opentelemetry-auto-psr6": "^0.0.7",
        "open-telemetry/opentelemetry-auto-psr14": "^0.0.7",
        "open-telemetry/opentelemetry-auto-psr16": "^0.0.7",
        "open-telemetry/opentelemetry-auto-symfony": "^1.4",
        "open-telemetry/sdk": "^1.15",
        "open-telemetry/transport-grpc": "^1.2",
        "pentatrion/vite-bundle": "^8.2.4",
        "symfony/asset": "8.1.*",
        "symfony/console": "8.1.*",
        "symfony/dotenv": "8.1.*",
        "symfony/flex": "^2.10",
        "symfony/framework-bundle": "8.1.*",
        "symfony/http-client": "8.1.*",
        "symfony/monolog-bundle": "^4.1.0",
        "symfony/runtime": "8.1.*",
        "symfony/translation": "8.1.*",
        "symfony/twig-bundle": "8.1.*",
        "symfony/ux-icons": ">=3",
        "symfony/ux-live-component": "^3.0",
        "symfony/ux-turbo": "^3.0",
        "symfony/ux-twig-component": "^3.0",
        "symfony/web-link": "8.1.*",
        "symfony/yaml": "8.1.*",
        "tales-from-a-dev/twig-tailwind-extra": "^1.1",
        "twig/extra-bundle": "^3.24",
        "twig/twig": "^3.24"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "symfony/flex": true,
            "symfony/runtime": true,
            "tbachert/spi": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "App\\Components\\": "templates/components/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "grpc/grpc": "*",
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*",
        "symfony/polyfill-php85": "*",
        "symfony/polyfill-mbstring": "*",
        "symfony/polyfill-intl-grapheme": "*",
        "symfony/polyfill-intl-normalizer": "*",
        "symfony/polyfill-deepclone": "*",
        "symfony/polyfill-intl-idn": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "lint": [
            "@putenv OTEL_PHP_DISABLED_INSTRUMENTATIONS=all",
            "php-cs-fixer check",
            "twig-cs-fixer lint"
        ],
        "lint:fix": [
            "@putenv OTEL_PHP_DISABLED_INSTRUMENTATIONS=all",
            "php-cs-fixer fix",
            "twig-cs-fixer fix"
        ],
        "phpstan": [
            "@putenv OTEL_PHP_DISABLED_INSTRUMENTATIONS=all",
            "phpstan"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.1.*",
            "docker": true
        },
        "symfony/flex": {
            "synchronize_package_json": false
        }
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "*",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan": "^2.2.14",
        "phpstan/phpstan-doctrine": "^2.0.20",
        "phpstan/phpstan-symfony": "^2.0.15",
        "symfony/debug-bundle": "8.1.*",
        "symfony/maker-bundle": "^1.68",
        "symfony/stopwatch": "8.1.*",
        "symfony/web-profiler-bundle": "8.1.*",
        "vincentlanglet/twig-cs-fixer": "*"
    }
}
