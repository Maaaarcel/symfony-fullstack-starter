<!DOCTYPE html>
<html lang="{{ app.locale }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Welcome!{% endblock %}</title>
        {% block stylesheets %}
            {{ reprise_entry_link_tags('app') }}
            {{ reprise_entry_link_tags('styles') }}
        {% endblock %}

        {% block javascripts %}
            {{ reprise_entry_script_tags('app') }}
            {{ reprise_entry_script_tags('styles') }}
        {% endblock %}
    </head>
    <body>
        {% block body %}{% endblock %}
    </body>
</html>
